# backend (NestJS) 환경변수
#
# 이 파일은 코드가 실제로 읽는 값과 일치해야 한다. env-drift.spec.ts가
# 소스를 훑어 여기 없는 변수를 찾으면 실패시킨다. 새 환경변수를 쓰기 시작하면
# 여기에도 추가할 것.

# ── 데이터베이스 ────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# ── 인증 ────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=

# ── 소셜 로그인 (카카오·구글) ───────────────────────────────────
# 미설정이면 소셜 로그인 라우트는 부팅되지만 실제 로그인 시도에서만 실패한다
# (fail-soft). 콘솔에서 발급받아 채우고, 각 콘솔에 Redirect URI를 등록할 것.
#
# 카카오: developers.kakao.com → REST API 키 + (보안) Client Secret
#   Redirect URI: {KAKAO_CALLBACK_URL}
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:3000/auth/kakao/callback
#
# 구글: Google Cloud Console → OAuth 클라이언트 ID/시크릿
#   승인된 리디렉션 URI: {GOOGLE_CALLBACK_URL}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
#
# 소셜 콜백 후 돌아갈 프론트 주소. 미설정 시 http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# 환자 가족의 실명을 AES-256으로 암호화하는 키. **32자 이상 필수.**
#
# 미설정이면 빈 문자열로 키가 파생되는데, salt가 소스에 하드코딩돼 있어
# 저장소를 읽은 누구나 같은 키를 만들 수 있다 — 암호화가 사실상 무의미해진다.
# NODE_ENV=production에서는 기동이 중단된다(개발에서는 경고만).
#
# 주의: 이 값을 나중에 바꾸면 **이미 저장된 데이터를 복호화할 수 없다.**
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_SECRET_KEY=

# ── ai-service 연동 ─────────────────────────────────────────────
# FastAPI(ai-service) 주소. 미설정 시 http://localhost:8000으로 폴백한다.
# 예전에는 이 값과 FASTAPI_URL 두 이름이 공존해서, 하나만 설정하면 절반의
# 기능(음성 또는 태깅·퀴즈·대화)만 조용히 죽었다. 이름은 하나로 통일했다.
AI_SERVICE_URL=

# 백엔드 ↔ ai-service 공유 인증 토큰 (양쪽 값이 같아야 한다)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 미설정 시 ai-service의 백엔드 전용 엔드포인트는 503으로 막힌다(의도된 fail-closed).
AI_SERVICE_TOKEN=

# ── 런타임 ──────────────────────────────────────────────────────
# production으로 두면 CRYPTO_SECRET_KEY 검증이 경고가 아니라 기동 중단이 된다.
NODE_ENV=

# HTTP 포트. 미설정 시 3000.
PORT=

# true면 다른 인스턴스가 이미 실행 중일 때 기동을 중단한다.
#
# 이 앱은 단일 인스턴스 전제다(사진·TTS 캐시가 로컬 디스크, 레이트리밋이
# 프로세스 메모리, 퀴즈 claim이 배타 리스가 아님). 미설정이면 경고만 남기는데,
# 롤링 배포 중에는 잠깐 두 인스턴스가 겹치는 게 정상이기 때문이다.
# 전환 순서는 DEPLOYMENT.md 참고.
ENFORCE_SINGLE_INSTANCE=

# 업로드된 기억 사진 저장 디렉토리. 미설정 시 tts-cache/memory-images.
# 상대 경로면 프로세스 cwd 기준으로 해석된다.
UPLOAD_DIR=
