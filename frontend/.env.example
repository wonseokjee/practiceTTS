# frontend (Vite) 환경변수
#
# Vite는 VITE_ 접두사가 붙은 값만 클라이언트 번들에 넣는다. 그리고 번들에
# 들어간 값은 **브라우저에서 누구나 볼 수 있다** — 비밀을 넣지 말 것.
#
# 코드가 실제로 읽는 값과 일치해야 한다. envDrift.test.ts가 소스를 훑어
# 여기 없는 변수를 찾으면 실패시킨다.

# ── API ─────────────────────────────────────────────────────────
# 백엔드(NestJS) 주소. 미설정 시 http://localhost:3000.
# 사진·음성도 이 오리진 기준으로 가져온다.
VITE_API_URL=

# ── 음성 엔진 선택 ──────────────────────────────────────────────
# 서버 STT(Azure, 백엔드 프록시 경유)를 쓸지. 끄면 브라우저 내장 인식.
VITE_USE_SERVER_STT=

# 서버 TTS(Azure)를 쓸지. 끄면 브라우저 내장 음성 합성.
VITE_USE_SERVER_TTS=

# ── 개발 편의 (프로덕션 빌드에서는 전부 무시된다) ───────────────
# 아래 값들은 import.meta.env.DEV 가드 안에서만 쓰인다. Vite가 프로덕션
# 빌드에서 DEV를 false로 정적 치환하므로 해당 코드는 번들에서 제거된다.
# 그래도 개발용 계정 정보이므로 .env는 절대 커밋하지 말 것.

# 로그인 없이 진입할 역할: patient | caregiver | off (미설정 시 patient)
VITE_DEV_AUTH=

# VITE_DEV_AUTH=off 이면서 아래 둘이 설정되면 앱 시작 시 자동 로그인한다.
VITE_DEV_AUTOLOGIN_EMAIL=
VITE_DEV_AUTOLOGIN_PASSWORD=

# 개발용 환자 ID 고정값.
VITE_DEV_PATIENT_ID=
