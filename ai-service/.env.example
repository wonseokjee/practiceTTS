# ai-service (FastAPI) 환경변수
#
# 코드가 실제로 읽는 값과 일치해야 한다. test_env_drift.py가 소스를 훑어
# 여기 없는 변수를 찾으면 실패시킨다.

# ── 외부 API 키 ─────────────────────────────────────────────────
# LLM. 마스킹 3계층·퀴즈·시나리오·대화 생성에 쓴다.
GEMINI_API_KEY=

# 퀴즈 생성 모델 오버라이드. 미설정 시 코드 기본값을 쓴다.
GEMINI_QUIZ_MODEL=
# 데일리 퀴즈 자기검증(critique) 패스 on/off. 미설정=on. 끄려면 0/false.
# 생성된 문항을 2차 LLM이 타당성 심사해 부적절 문항을 폐기한다(실패 시 원문 유지).
QUIZ_CRITIQUE_ENABLED=

# Azure Speech (STT/TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── 서비스 간 인증 ──────────────────────────────────────────────
# 백엔드 ↔ ai-service 공유 인증 토큰 (양쪽 값이 같아야 한다)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 미설정 시 모든 엔드포인트가 503으로 막힌다(의도된 fail-closed).
AI_SERVICE_TOKEN=

# ── TTS 캐시 ────────────────────────────────────────────────────
# 생성된 음성 파일 저장 디렉토리.
TTS_CACHE_DIR=

# 캐시 디스크 상한(바이트). 넘으면 LRU로 축출한다. 미설정 시 200MB.
TTS_CACHE_MAX_BYTES=

# ── 레이트리밋 (전역 회로차단기) ────────────────────────────────
# 주의: 이 값들은 **사용자별이 아니다.** /stt·/tts를 백엔드 프록시 뒤로
# 옮기면서 여기서 보이는 IP가 전부 백엔드 하나가 됐다. 사용자별 격리는
# 백엔드가 인증된 사용자 ID로 한다(tts 30, stt 12 /분).
# 따라서 이 값은 백엔드 한도 × 예상 동시 사용자 수보다 커야 한다.
# 미설정 시 각각 600, 240.
TTS_RATE_LIMIT_PER_MIN=
STT_RATE_LIMIT_PER_MIN=
# 발음 평가(/pronunciation)도 Azure 유료 호출이라 전역 회로차단기를 둔다.
# **단위는 요청이 아니라 Azure 호출 수다.** 경쟁자 모드(이웃 비교 채점)는 요청 하나가
# 최대 6호출(목표 1 + 이웃 3 + 인식 1 + 인식 결과 채점 1)을 내고 그만큼 차감된다.
# 이름대기에 켜면 백엔드 한도(12/분/사용자) × 동시 사용자 × 6을 감당하는지 볼 것.
# 미설정 시 240.
PRONUNCIATION_RATE_LIMIT_PER_MIN=

# 프록시가 붙인 X-Forwarded-For를 신뢰할지. 신뢰할 수 있는 프록시 뒤에
# 있을 때만 켤 것 — 아니면 클라이언트가 IP를 위조해 레이트리밋을 우회한다.
TRUST_PROXY_HEADER=
